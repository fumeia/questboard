<?xml version="1.0" encoding="utf-8"?>
<!-- Questboard home-screen widget: no box, centred text, like a minimal launcher. Filled in by sys/TodayWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_ring"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Level" />
        <TextView
            android:id="@+id/w_focus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/widget_text"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_timer_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/w_timer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/widget_violet"
            android:textSize="15sp" />
        <Chronometer
            android:id="@+id/w_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/widget_violet"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/w_reviews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:textColor="@color/widget_gold"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
